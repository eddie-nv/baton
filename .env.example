# ─────────────────────────────────────────────────────────────
# Baton environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# === Backend ===

# Port the backend HTTP server listens on.
BATON_PORT=3000

# Redis connection string. Default points at the docker-compose service.
REDIS_URL=redis://localhost:6379

# Node environment (development | production)
NODE_ENV=development

# === MCP shim (runs on user's laptop / IDE host) ===

# Base URL of the Baton backend.
#   Local dev:  http://localhost:3000
#   Production: https://mcp.your-domain.com
BATON_API_URL=http://localhost:3000

# Room bearer capability — treat like a password.
# Anyone with this token can read/write the room.
# Obtain by calling the create_room MCP tool (or npm run seed).
BATON_ROOM_ID=

# Actor identity for events the shim emits (e.g. "alice@claude-code").
BATON_ACTOR_ID=

# Default feature_id if the caller omits one. Normalized git branch
# name, e.g. feat_payments_idempotency.
BATON_FEATURE_ID=

# === Production deployment (optional) ===

# Your public domain (used by Caddy / reverse proxy config).
APP_DOMAIN=your-domain.com
